<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!--
    thirukkural.db is a static, read-only reference dataset bundled as an app asset
    (createFromAsset) and re-created on demand — it is never user-generated data, so backing it
    up (and its -wal/-shm/-journal companions) would only waste backup quota and restore time.
    The datastore "settings" preferences file (theme/widget config) is the only user data worth
    restoring, so it is intentionally left included by not excluding it here.
    -->
    <cloud-backup>
        <exclude domain="database" path="thirukkural.db" />
        <exclude domain="database" path="thirukkural.db-wal" />
        <exclude domain="database" path="thirukkural.db-shm" />
        <exclude domain="database" path="thirukkural.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="thirukkural.db" />
        <exclude domain="database" path="thirukkural.db-wal" />
        <exclude domain="database" path="thirukkural.db-shm" />
        <exclude domain="database" path="thirukkural.db-journal" />
    </device-transfer>
</data-extraction-rules>